# Phase 1 runs fully in mock mode (no AWS credentials required yet)
NEXT_PUBLIC_USE_MOCK_AWS=true

# AWS Region & Scoped IAM User (Wired in Phases 2-4)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phase 2: Amazon Bedrock Generative Voice Deterrent
BEDROCK_SPEECH_MODEL_ID=amazon.nova-2-sonic-v1:0
BEDROCK_TEXT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Phase 3: Amazon Location Service V2 (API Key — no legacy V1 Map/RouteCalculator resources)
NEXT_PUBLIC_AMAZON_LOCATION_API_KEY=
NEXT_PUBLIC_AMAZON_LOCATION_REGION=us-east-1

# Phase 4: AWS AppSync Events + DynamoDB + SNS Fallback
NEXT_PUBLIC_APPSYNC_EVENTS_HTTP_ENDPOINT=
NEXT_PUBLIC_APPSYNC_EVENTS_REALTIME_ENDPOINT=
NEXT_PUBLIC_APPSYNC_EVENTS_API_KEY=
DYNAMODB_TABLE_NAME=sentinel-ai-incidents
SNS_FALLBACK_TOPIC_ARN=
